# VITE_GROQ_API_KEY: Required for the AI Operator Copilot (Groq chat completions).
# Get a free key at https://console.groq.com/keys
# NOTE: VITE_ vars are exposed in the client bundle — use a restricted key.
VITE_GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
